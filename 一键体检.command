#!/usr/bin/env bash
# ============================================================
#  vpn-guard 环境对照体检（macOS）—— 双击本文件即可
#
#  只读：不改任何系统设置，不装任何东西，不需要输入密码。
#  产出：桌面上一份已脱敏的对照报告，发不发由你决定。
#
#  【第一次双击会被系统拦下，这是正常的】
#  macOS 对从网上下载的脚本默认不放行，会提示「无法打开，因为来自身份不明的开发者」。
#  两种解决办法，任选其一：
#
#    办法一（推荐，最快）：
#      在「访达」里 **右键点击本文件 → 打开** → 弹窗里再点一次「打开」。
#      只需要做这一次，之后双击就能直接跑。
#
#    办法二：
#      打开「终端」，把下面这行粘进去回车（把 <文件夹> 换成解压出来的那个文件夹）：
#        xattr -dr com.apple.quarantine <文件夹>
#
#  如果双击后提示「没有权限」，同样在终端里执行：
#      chmod +x "<文件夹>/一键体检.command" "<文件夹>"/*.sh
# ============================================================

# 双击 .command 时，终端的工作目录是用户主目录而不是脚本目录，必须先切过来。
cd "$(dirname "$0")" || exit 1

# 兜底：解压后可执行位可能丢失（尤其是从 Windows 打的包）。
chmod +x ./*.sh 2>/dev/null

bash ./field-report.sh

echo ""
echo "============================================================"
echo " 已完成。可以关掉这个窗口了。"
echo "============================================================"
